<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Nothing is eligible for cloud backup or
    device-to-device transfer. Pocket Budget backups are user-initiated,
    encrypted exports handled inside the app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
